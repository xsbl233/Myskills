rs --> rp
rp -->|报告| fa
lg -->|checkpoint| st

%% B: DeepSeek Harness
flowchart TD
subgraph L0["接口层"]
  gui["Web GUI / CLI"]
end
subgraph L1["调度层"]
  loop["agent-loop"]
  ctx["上下文组装/压缩"]
  rtr["Router (super-agent)"]
end
subgraph L2["执行层"]
  wk["Worker (隔离子会话)"]
