%% A: DeerFlow 2.0
flowchart TD
subgraph L0["接口层"]
  fa["FastAPI gateway"]
  web["Web UI"]
end
subgraph L1["编排层"]
  co["coordinator"]
  pl["planner"]
  rs["researcher"]
  rp["reporter"]
end
subgraph L2["运行层"]
  lg["LangGraph 图"]
  st["持久化状态/checkpoint"]
  tg["tools (search/scrape)"]
end
fa -->|query| co
co --> pl
pl -->|步骤| rs
